# Telegram Bot
BOT_TOKEN=your_telegram_bot_token
ALLOWED_USERS=123456789,987654321
# Proxy (optional, e.g. socks5://127.0.0.1:1080 or http://127.0.0.1:7890)
PROXY_URL=

# Pyrogram (for large file downloads >20MB, get from https://my.telegram.org)
API_ID=
API_HASH=

# Navidrome
NAVIDROME_URL=http://localhost:4533
NAVIDROME_USER=admin
NAVIDROME_PASS=your_password
MUSIC_FOLDER=D:\Music\songs\

# Local folder import. Trigger it manually with the Telegram /import command.
# Successfully imported source files are deleted from the incoming folder.
LOCAL_IMPORT_FOLDER=D:\Music\incoming\
LOCAL_IMPORT_SETTLE_SECONDS=10

# Transcode local imports above the threshold to AAC in an M4A container.
# auto prefers qaac, then aac_at, then FFmpeg native AAC at 256 kbps.
LOCAL_IMPORT_TRANSCODE_ENABLED=false
LOCAL_IMPORT_TRANSCODE_THRESHOLD_KBPS=320
LOCAL_IMPORT_AAC_BITRATE_KBPS=256
LOCAL_IMPORT_AAC_ENCODER=auto
# FFMPEG_COMMAND=ffmpeg
# QAAC_COMMAND=qaac
# LOCAL_IMPORT_TRANSCODE_TIMEOUT=1800

# Post-processing hook (optional). {path} is replaced with the saved file path.
# POST_HOOK=python /path/to/script.py {path}
